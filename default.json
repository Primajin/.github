{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Primajin shared Renovate preset: non-major updates bundled and automerged on weekends, majors bundled for manual review",
  "extends": [
    "config:recommended",
    ":disableDependencyDashboard"
  ],
  "timezone": "Europe/Berlin",
  "schedule": [
    "every weekend"
  ],
  "commitMessagePrefix": ":books:",
  "labels": [
    "dependencies"
  ],
  "platformCommit": "enabled",
  "prConcurrentLimit": 3,
  "prHourlyLimit": 0,
  "prTitleStrict": true,
  "prHeader": "{{#if isGroup}}Updates {{#each (distinct (lookupArray upgrades \"depName\"))}}`{{{this}}}`{{#unless @last}}, {{/unless}}{{/each}}.\n\n{{/if}}",
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": [
      "every weekend"
    ],
    "commitMessageAction": "Refresh",
    "commitMessageTopic": "lockfile"
  },
  "packageRules": [
    {
      "description": "Bundle all non-major updates into one PR and automerge it once checks are green",
      "matchPackageNames": [
        "*"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest",
        "pinDigest"
      ],
      "groupName": "non-major dependencies",
      "automerge": true
    },
    {
      "description": "Bundle all major updates into one PR; never automerge, review manually",
      "matchPackageNames": [
        "*"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "major dependencies",
      "automerge": false
    },
    {
      "description": "Hold typescript below 7: typescript-eslint, and so xo, does not support TypeScript 7 yet and the lint job crashes with 'typescript-eslint does not support TS 7.0'. Remove this rule once xo supports it.",
      "matchPackageNames": [
        "typescript"
      ],
      "allowedVersions": "<7"
    }
  ],
  "ignorePresets": [
    "group:monorepos"
  ]
}
