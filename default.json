{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Primajin shared Renovate preset: non-major updates bundled and automerged, majors bundled for manual review",
  "extends": [
    "config:recommended",
    ":disableDependencyDashboard"
  ],
  "timezone": "Europe/Berlin",
  "schedule": [
    "before 6am on saturday"
  ],
  "commitMessagePrefix": ":books:",
  "labels": [
    "dependencies"
  ],
  "platformCommit": "enabled",
  "prConcurrentLimit": 3,
  "prHourlyLimit": 0,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": [
      "before 6am on saturday"
    ]
  },
  "packageRules": [
    {
      "description": "Bundle all non-major updates into one PR and automerge it once checks are green",
      "matchPackageNames": [
        "*"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest",
        "pinDigest"
      ],
      "groupName": "all non-major dependencies",
      "automerge": true
    },
    {
      "description": "Bundle all major updates into one PR; never automerge, review manually",
      "matchPackageNames": [
        "*"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "all major dependencies",
      "automerge": false
    }
  ]
}
