{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Primajin shared Renovate preset: everything bundled into a single weekly PR",
  "extends": [
    "config:recommended",
    ":disableDependencyDashboard"
  ],
  "timezone": "Europe/Berlin",
  "schedule": [
    "at any time"
  ],
  "commitMessagePrefix": ":books:",
  "labels": [
    "dependencies"
  ],
  "platformCommit": "enabled",
  "prConcurrentLimit": 1,
  "prHourlyLimit": 0,
  "separateMajorMinor": false,
  "separateMultipleMajor": false,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "at any time"
    ]
  },
  "packageRules": [
    {
      "description": "Bundle every update (all ecosystems, all update types) into one PR",
      "matchPackageNames": [
        "*"
      ],
      "groupName": "all dependencies"
    }
  ]
}
